 </section>

 <!-- ===== Document ouvert ===== -->
 <section id="doc" hidden>
  <header id="titlebar">
   <button class="tbb" id="tbSave" title="Enregistrer">💾</button>
   <button class="tbb" id="tbUndo" title="Annuler">↶</button>
   <button class="tbb" id="tbRedo" title="Rétablir">↷</button>
