<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#3b2fc9">
<meta name="description" content="Kalamu — le traitement de texte des étudiants de Lubumbashi. Une application LushiPratique.">
<title>Kalamu</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%233b2fc9'/%3E%3Cpath d='M18 48l5-17 16-16 10 10-16 16z' fill='%23ffd23f'/%3E%3Cpath d='M18 48l5-17 7 7z' fill='%23fff'/%3E%3C/svg%3E">
<style>
*{box-sizing:border-box}
:root{--brand:#3b2fc9;--bg:#e9ecf5;--panel:#fff;--ink:#1c1f33;--muted:#5f6688;--line:#d8dbea;--paper:#fff;--paperInk:#151515;--hover:#eef0ff;--rc:#1f6fe5;--shadow:0 1px 3px rgba(20,24,60,.12),0 8px 24px rgba(20,24,60,.10)}
:root.dark{--bg:#12131b;--panel:#1d1f2e;--ink:#e9eaf4;--muted:#a2a8c6;--line:#343852;--paper:#262839;--paperInk:#ecedf6;--hover:#2b2e48}
html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font:14px/1.35 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;-webkit-tap-highlight-color:transparent;overflow:hidden}
button,select,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
#app{height:100%}
/* ---------- Accueil (écran de départ) ---------- */
#home{height:100%;overflow:auto;display:flex;flex-direction:column}
.hhero{background:linear-gradient(115deg,#3b2fc9,#7b3fe4 50%,#e2187b);color:#fff;padding:16px 20px 18px;flex:none}
.hlogo{display:flex;align-items:center;gap:12px}
.hlogo b{font-size:28px;letter-spacing:.5px}
.hlogo small{display:block;opacity:.9;font-size:13px}
.hmain{flex:1;padding:6px 20px 16px;max-width:1100px;width:100%;margin:0 auto}
.hmain h2{font-size:13px;margin:16px 0 10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.tpls{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:12px}
.tpl{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:9px;text-align:left;display:flex;flex-direction:column;gap:7px;box-shadow:var(--shadow)}
.tpl:active{transform:scale(.97)}
.mini{height:104px;background:#fff;border-radius:4px;border:1px solid #e1e4f0;overflow:hidden;padding:8px 9px}
.mini i{display:block;height:4px;border-radius:3px;background:#d7dbea;margin:6px 0}
.mini i.t{background:var(--k);height:7px;width:62%;margin:10px auto 8px}
.mini i.s{width:45%;background:var(--k);opacity:.6}
.mini i.c{width:70%;margin-left:auto;margin-right:auto}
.mini i.r{width:40%;margin-left:auto}
.mini .band{height:26px;background:var(--k);border-radius:3px;margin:-2px -3px 8px}
.tpl b{font-size:13px}
.tpl small{color:var(--muted);font-size:11.5px}
.hbtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.btn{border:0;border-radius:10px;padding:10px 14px;background:var(--brand);color:#fff;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn.alt{background:var(--panel);color:var(--ink);border:1px solid var(--line)}
.btn.red{background:#e0242e}.btn.green{background:#13923e}
.btn:active{filter:brightness(.92)}
.recent{display:flex;flex-direction:column;gap:6px}
.ritem{display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:6px 6px 6px 12px}
.ritem .rn{flex:1;min-width:0;text-align:left;background:none;border:0;padding:4px 0}
.ritem .rn b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ritem .rn small{color:var(--muted)}
.xbtn{border:0;background:transparent;width:36px;height:36px;border-radius:8px;font-size:17px;color:var(--muted);flex:none}
.xbtn:hover,.xbtn:active{background:#e0242e;color:#fff}
.empty{color:var(--muted);padding:10px 2px}
.hfoot{text-align:center;color:var(--muted);font-size:12px;padding:12px}
/* ---------- Document ---------- */
#doc{height:100%;display:flex;flex-direction:column}
#titlebar{height:40px;flex:none;background:linear-gradient(90deg,#3b2fc9,#6a35dc);color:#fff;display:flex;align-items:center;gap:2px;padding:0 4px}
.tbb{border:0;background:transparent;color:#fff;width:38px;height:34px;border-radius:7px;font-size:17px;display:grid;place-items:center;flex:none}
.tbb:hover,.tbb:active{background:rgba(255,255,255,.18)}
#docName{flex:1;min-width:60px;background:transparent;border:1px solid transparent;color:#fff;text-align:center;font-weight:600;border-radius:6px;padding:5px 6px}
#docName:focus{background:rgba(255,255,255,.16);outline:none}
#saveState{font-size:11px;opacity:.85;white-space:nowrap;margin-right:4px}
#closeDoc{font-size:19px}
#closeDoc:hover,#closeDoc:active{background:#e0242e}
#tabs{flex:none;display:flex;align-items:center;gap:5px;overflow-x:auto;background:var(--panel);padding:5px 6px;scrollbar-width:none}
#tabs::-webkit-scrollbar{display:none}
.tab{flex:none;border:2px solid color-mix(in srgb,var(--tc) 40%,transparent);background:transparent;color:var(--tc);padding:3px 11px;border-radius:8px;font-weight:700;white-space:nowrap;font-size:13.5px}
.tab.on{background:var(--tc);border-color:var(--tc);color:#fff}
.tab.file{background:#e0242e;border-color:#e0242e;color:#fff}
#collapse{margin-left:auto;flex:none;border:0;background:transparent;color:var(--muted);width:32px;height:28px;border-radius:6px;font-size:15px}
#ribbon{flex:none;display:flex;overflow-x:auto;background:var(--panel);border-top:1px solid var(--line);border-bottom:3px solid var(--rc);padding:4px 2px 0;scrollbar-width:thin}
#ribbon.collapsed{display:none}
.grp{flex:none;display:flex;flex-direction:column;border-right:1px solid var(--line);padding:0 5px}
.gitems{display:flex;align-items:center;gap:2px;flex:1}
.gcol{display:flex;flex-direction:column;gap:2px}
.grow{display:flex;gap:1px;align-items:center}
.glab{font-size:10.5px;color:var(--muted);text-align:center;padding:2px 0 3px;white-space:nowrap}
.rb{border:1px solid transparent;background:transparent;border-radius:6px;min-width:32px;height:30px;padding:0 6px;display:inline-flex;align-items:center;justify-content:center;gap:5px;white-space:nowrap;font-size:13px;color:var(--ink)}
.rb:hover{background:var(--hover)}
.rb:active{background:color-mix(in srgb,var(--rc) 22%,transparent)}
.rb.on{background:color-mix(in srgb,var(--rc) 18%,transparent);border-color:color-mix(in srgb,var(--rc) 50%,transparent)}
.rb.big{flex-direction:column;height:62px;min-width:56px;padding:3px 6px;gap:3px;font-size:11.5px;line-height:1.1;white-space:normal;max-width:84px;text-align:center}
.rb.big .ic{font-size:23px;line-height:1}
.rb .ic{font-size:15px;line-height:1;display:inline-flex;align-items:center}
.rsel{height:30px;border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:0 2px;max-width:140px}
#selSize{width:58px}
.aic{display:inline-flex;flex-direction:column;align-items:center;font-weight:800;line-height:1;font-size:15px}
.aic i{width:16px;height:4px;border-radius:2px;margin-top:1px}
.stp{font-size:12px;padding:0 2px}
.stp.h1{color:#2b3fae;font-weight:700;font-size:14px}.stp.h2{color:#2b3fae;font-weight:700}.stp.h3{color:#3d4ca8;font-weight:600}.stp.q{font-style:italic;color:#8a3fd1}
#ruler{flex:none;height:20px;background:var(--panel);border-bottom:1px solid var(--line);overflow:hidden;position:relative}
#rulerIn{position:absolute;top:3px;height:14px;background:#fff;border:1px solid #c9cde0;border-radius:2px;font-size:8.5px;color:#666}
#rulerIn b{position:absolute;top:0;font-weight:400;transform:translateX(-50%);line-height:13px}
#rulerIn .mg{position:absolute;top:0;bottom:0;background:#d9dcea}
#scroller{flex:1;overflow:auto;background:var(--bg);padding:14px 8px 60px;position:relative}
#zoomer{width:max-content;margin:0 auto}
#sheet{position:relative}
#page{background:var(--paper);color:var(--paperInk);box-shadow:var(--shadow);outline:none;position:relative;caret-color:#3b2fc9}
.hf{position:absolute;color:#8a8fa8;font-size:9pt;text-align:center;pointer-events:auto;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-radius:4px;padding:1px 4px;z-index:2;font-family:Calibri,Carlito,Roboto,Arial,sans-serif}
.hf:empty{display:none}
.hf:hover{background:rgba(59,47,201,.08)}
#status{flex:none;height:28px;display:flex;align-items:center;gap:12px;padding:0 10px;background:#3b2fc9;color:#fff;font-size:12px;white-space:nowrap;overflow:hidden}
#status .sp{flex:1}
#status button{border:0;background:rgba(255,255,255,.18);color:#fff;border-radius:5px;height:21px;min-width:26px;font-weight:700}
#zv{min-width:44px;text-align:center}
#ctx{position:fixed;right:12px;bottom:40px;z-index:30;border:0;border-radius:20px;padding:9px 15px;background:#13923e;color:#fff;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,.25)}
#exitRead{position:fixed;top:8px;right:10px;z-index:30;display:none}
#doc.reading #titlebar,#doc.reading #tabs,#doc.reading #ribbon,#doc.reading #ruler{display:none}
#doc.reading #exitRead{display:inline-flex}
#doc.web #page{width:auto!important;min-height:0!important;background-image:none!important;padding:18px 22px!important;box-shadow:none}
#doc.web #zoomer{width:auto}
#doc.web .hf{display:none}
#doc.kb:not(.force) #ribbon,#doc.kb #ruler{display:none}
#portrait{flex:none;display:flex;align-items:center;gap:8px;background:#fff6d6;color:#6b4e00;font-size:12.5px;padding:6px 6px 6px 12px;border-bottom:1px solid #f0d78a}
#portrait span{flex:1}
/* ---------- Fenêtres ---------- */
.wback{position:fixed;inset:0;background:rgba(15,18,40,.38);display:flex;align-items:center;justify-content:center;padding:8px;z-index:50;animation:fade .15s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.win{background:var(--panel);color:var(--ink);border-radius:13px;box-shadow:0 20px 60px rgba(0,0,0,.35);width:min(470px,100%);max-height:100%;display:flex;flex-direction:column;overflow:hidden;border-top:5px solid var(--c);animation:pop .16s}
@keyframes pop{from{transform:scale(.96)}to{transform:none}}
.win.wide{width:min(900px,100%)}
.whead{display:flex;align-items:center;gap:9px;padding:6px 6px 6px 10px;border-bottom:1px solid var(--line);flex:none}
.whead b{flex:1;font-size:15.5px}
.wic{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:color-mix(in srgb,var(--c) 16%,transparent);font-size:16px;flex:none}
.wx{border:0;width:38px;height:38px;border-radius:9px;background:transparent;font-size:20px;color:var(--muted);flex:none}
.wx:hover,.wx:active{background:#e0242e;color:#fff}
.wbody{padding:12px;overflow:auto;flex:1;min-height:0}
.wfoot{padding:8px 12px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end;flex:none;flex-wrap:wrap}
.f{display:flex;flex-direction:column;gap:4px;margin-bottom:10px;flex:1;min-width:120px}
.f label{font-size:12px;color:var(--muted);font-weight:600}
.frow{display:flex;gap:10px;flex-wrap:wrap}
.in{border:1px solid var(--line);border-radius:8px;padding:8px 9px;background:var(--bg);width:100%}
textarea.in{resize:vertical}
.hint{color:var(--muted);font-size:12.5px;margin:0 0 10px}
.opts{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px}
.opt{border:1.5px solid var(--line);background:var(--panel);border-radius:10px;padding:9px 8px;text-align:center;font-size:13px}
.opt:hover{border-color:var(--c)}
.opt.on{border-color:var(--c);background:color-mix(in srgb,var(--c) 12%,transparent);font-weight:700}
.opt .big{font-size:24px;display:block;margin-bottom:3px}
.opt small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.sws{display:flex;flex-wrap:wrap;gap:8px}
.sw{width:32px;height:32px;border-radius:50%;border:2px solid var(--panel);box-shadow:0 0 0 1px var(--line);padding:0}
.sw.on{box-shadow:0 0 0 3px var(--c)}
.ftiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:9px}
.ftile{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;text-align:left}
.ftile:hover{border-color:#e0242e;background:#fff5f5}
:root.dark .ftile:hover{background:#2c1d22}
.ftile .e{font-size:24px}
.ftile b{display:block;font-size:13.5px}
.ftile small{color:var(--muted);font-size:11.5px}
.steps{margin:0 0 10px;padding-left:20px}
.steps li{margin-bottom:7px}
.note{background:color-mix(in srgb,var(--c) 10%,transparent);border-left:4px solid var(--c);padding:8px 10px;border-radius:6px;font-size:13px;margin:8px 0}
.list{display:flex;flex-direction:column;gap:6px}
.litem{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:9px;padding:6px 6px 6px 10px}
.litem>div{flex:1;min-width:0}
.litem small{color:var(--muted)}
.tgrid{display:grid;grid-template-columns:repeat(8,28px);gap:3px;margin-bottom:10px}
.tgrid i{width:28px;height:22px;border:1px solid var(--line);border-radius:3px;background:var(--panel)}
.tgrid i.on{background:color-mix(in srgb,var(--c) 35%,transparent);border-color:var(--c)}
.shp{padding:6px}.shp svg{width:100%;height:46px}
.prev{border:1px solid var(--line);border-radius:8px;padding:10px;background:#fff;color:#111;max-height:46vh;overflow:auto}
.symg{display:grid;grid-template-columns:repeat(auto-fill,minmax(40px,1fr));gap:5px}
.symg button{height:40px;border:1px solid var(--line);border-radius:8px;background:var(--panel);font-size:19px}
.dtools{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.dtools .opt{padding:6px 9px}
.dsz{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}
.dwrap{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff;background-image:radial-gradient(#dfe2ee 1px,transparent 1px);background-size:20px 20px}
#dcv{width:100%;height:auto;display:block;touch-action:none;aspect-ratio:12/7}
.kbd{display:inline-block;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 5px;font-size:12px;background:var(--bg)}
table.help{border-collapse:collapse;width:100%;font-size:13px}
table.help td{border-bottom:1px solid var(--line);padding:6px 4px;vertical-align:top}
.dot{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:6px;vertical-align:-1px}
#toast{position:fixed;left:50%;bottom:44px;transform:translateX(-50%);background:#1c1f33;color:#fff;padding:10px 16px;border-radius:10px;font-size:13.5px;z-index:90;max-width:min(92vw,520px);text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .2s}
#toast.on{opacity:1}
#printArea{display:none}
@media (max-height:430px){
 #titlebar{height:34px}.tbb{height:30px;width:34px}
 #tabs{padding:3px 5px}.tab{padding:2px 9px;font-size:13px}
 .rb.big{height:56px;min-width:50px}.rb.big .ic{font-size:20px}.rb{height:27px}.rsel{height:27px}
 #status{height:24px}#scroller{padding-top:8px}
 .hhero{padding:10px 18px}.hlogo b{font-size:22px}
}
::highlight(kfind){background:#ffe55c;color:#000}
::highlight(kfindcur){background:#ff9f1c;color:#000}
@media print{
 html,body{overflow:visible!important;height:auto!important;background:#fff!important}
 #app,#wins,#toast,#ctx,#exitRead{display:none!important}
 #printArea{display:block!important;color:#000}
 #printArea .pb{break-after:page;border:0!important;height:0;margin:0}
 #printArea .pb::after,#printArea .cb::after{display:none}
 #printArea .cb{break-after:column;border:0}
 #printArea .cmt{background:none!important;border:0!important}
 #printArea.brd{padding:0.6cm;-webkit-box-decoration-break:clone;box-decoration-break:clone}
 #printArea .pbimg{position:fixed;inset:0;width:100%;height:100%;display:block;max-width:none}
 #printArea .mf{background:none!important}
 #printArea a{color:inherit;text-decoration:none}
 #printArea h1,#printArea h2,#printArea h3{break-after:avoid}
 #printArea table,#printArea img,#printArea .shape,#printArea .chart{break-inside:avoid}
 .pwm{position:fixed;top:40%;left:-10%;right:-10%;text-align:center;transform:rotate(-35deg);font-family:Arial,sans-serif;font-weight:700;color:rgba(0,0,0,.09);white-space:nowrap}
}
</style>
<style id="docCss">
.docbody{font-family:Calibri,Carlito,"Segoe UI",Roboto,Arial,sans-serif;font-size:12pt;line-height:1.3;overflow-wrap:break-word}
.docbody p{margin:0 0 6pt}
.docbody h1{font-size:18pt;color:#2b3fae;margin:14pt 0 6pt;font-weight:700;line-height:1.2}
.docbody h2{font-size:15pt;color:#2b3fae;margin:12pt 0 4pt;font-weight:700;line-height:1.2}
.docbody h3{font-size:13pt;color:#3d4ca8;margin:10pt 0 4pt;font-weight:700}
.docbody blockquote{margin:6pt 0 6pt 1cm;padding-left:10px;border-left:3px solid #8a3fd1;font-style:italic;color:#555}
.docbody ul,.docbody ol{margin:0 0 6pt;padding-left:1.1cm}
.docbody table.kt{border-collapse:collapse;width:100%;margin:6pt 0}
.docbody table.kt td,.docbody table.kt th{border:1px solid #777;padding:4px 6px;vertical-align:top;min-width:28px;text-align:left}
.docbody table.kt th{background:#1f6fe5;color:#fff;font-weight:700}
.docbody table.ts-vert th{background:#13923e}
.docbody table.ts-grille th{background:none;color:inherit}
.docbody table.ts-raye tr:nth-child(even) td{background:#eaf0ff}
.docbody table.ts-raye th{background:#8a3fd1}
.docbody table.ts-sans td,.docbody table.ts-sans th{border-color:transparent;background:none;color:inherit}
.docbody img{max-width:100%;height:auto}
.docbody .pb{display:block;height:0;border-top:2px dashed #b9bed6;margin:12px 0;position:relative}
.docbody .pb::after{content:"Saut de page";position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:#fff;color:#8a8fa8;font-size:9pt;padding:0 8px;font-style:normal}
.docbody .cb{display:block;height:0;border-top:2px dotted #f08a00;margin:8px 0;position:relative}
.docbody .cb::after{content:"Saut de colonne";position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:#fff;color:#f08a00;font-size:8pt;padding:0 6px}
.docbody .shape,.docbody .chart{display:inline-block;max-width:100%;vertical-align:middle}
.docbody .shape svg,.docbody .chart svg{width:100%;height:auto;display:block}
.docbody .ksel{outline:3px solid #1f6fe5;outline-offset:2px}
.docbody .tbox{border:1.5px solid #555;padding:8px 10px;margin:6pt 0;border-radius:4px}
.docbody .toc{margin:6pt 0 10pt}
.docbody .toc p{display:flex;gap:4px;margin:0 0 3pt;align-items:flex-end}
.docbody .toc a{color:inherit;text-decoration:none}
.docbody .toc .dots{flex:1;border-bottom:1.5px dotted #888;margin-bottom:5px;min-width:10px}
.docbody .toc .toc-t{font-size:16pt;font-weight:700;color:#2b3fae;display:block;margin-bottom:6pt}
.docbody .toc-1{font-weight:700}
.docbody .toc-2{padding-left:.8cm}
.docbody .toc-3{padding-left:1.6cm;font-size:11pt}
.docbody sup.fn{color:#8a3fd1;font-weight:700;cursor:pointer}
.docbody .notes{font-size:10pt;border-top:1px solid #999;margin-top:18pt;padding-top:6pt}
.docbody .notes .nt-t{font-weight:700}
.docbody .cmt{background:#fff1a8;border-bottom:2px solid #f0a800;cursor:pointer}
.docbody .mf{background:#d6f2f4;color:#0b6f79;border-radius:3px;padding:0 2px}
.docbody .caption{font-style:italic;color:#2b3fae;font-size:10pt;text-align:center}
.docbody .drop{float:left;font-size:3.4em;line-height:.85;padding:3px 6px 0 0;font-weight:700;color:#2b3fae}
.docbody .frac{display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;font-size:.9em;line-height:1.1}
.docbody .frac>span:first-child{border-bottom:1px solid currentColor;padding:0 3px}
.docbody .eq{font-family:"Cambria Math","Times New Roman",serif;font-style:italic}
.docbody a{color:#1f6fe5}
.docbody hr{border:0;border-top:1.5px solid #888;margin:8pt 0}
#page.marks p::after,#page.marks h1::after,#page.marks h2::after,#page.marks h3::after,#page.marks li::after{content:"¶";color:#9aa0c0;font-weight:400;font-style:normal;font-size:11pt;margin-left:2px}
</style>
</head>
<body>
<div id="app">
 <!-- ===== Écran de départ ===== -->
 <section id="home">
  <div class="hhero">
