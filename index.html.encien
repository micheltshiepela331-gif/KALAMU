   <span id="saveState"></span>
   <button class="tbb" id="tbPrint" title="Imprimer">🖨️</button>
   <button class="tbb" id="closeDoc" title="Fermer le document">✕</button>
  </header>
  <nav id="tabs"></nav>
  <div id="ribbon"></div>
  <div id="ruler"><div id="rulerIn"></div></div>
  <div id="portrait" hidden><span>📱↻ Tournez votre téléphone à l'horizontale pour travailler comme sur Word.</span><button class="xbtn" id="portraitX" aria-label="Fermer">✕</button></div>
  <main id="scroller">
   <div id="zoomer"><div id="sheet">
    <div class="hf" id="hdrV" title="Modifier l'en-tête"></div>
    <div id="page" class="docbody" contenteditable="true" spellcheck="true"></div>
    <div class="hf" id="ftrV" title="Modifier le pied de page"></div>
   </div></div>
  </main>
  <footer id="status">
   <span id="stPage">Page 1 sur 1</span><span id="stWords">0 mot</span><span id="stLang">Français</span><span class="sp"></span>
   <button id="zOut" aria-label="Zoom arrière">−</button><span id="zv">100 %</span><button id="zIn" aria-label="Zoom avant">+</button>
  </footer>
