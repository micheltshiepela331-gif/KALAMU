<!-- Pièces de l'application Android (ignorées par le navigateur, utilisées par l'usine APK) -->
<script type="text/plain" id="apk-main">
package com.lushipratique.kalamu;

import android.os.Bundle;
import com.getcapacitor.BridgeActivity;

public class MainActivity extends BridgeActivity {
    @Override
    public void onCreate(Bundle savedInstanceState) {
        registerPlugin(KalamuNativePlugin.class);
        super.onCreate(savedInstanceState);
    }
}
</script>
<script type="text/plain" id="apk-plugin">
package com.lushipratique.kalamu;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.print.PrintAttributes;
import android.print.PrintDocumentAdapter;
import android.print.PrintManager;
import android.util.Base64;
import android.webkit.WebView;
import androidx.activity.result.ActivityResult;
import androidx.core.content.FileProvider;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.ActivityCallback;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.io.File;
import java.io.FileOutputStream;
import java.io.OutputStream;

// Kalamu : enregistrer (téléphone ou clé USB), imprimer (Wi-Fi, Bluetooth, PDF) et partager
@CapacitorPlugin(name = "KalamuNative")
public class KalamuNativePlugin extends Plugin {

    @PluginMethod
    public void saveFile(PluginCall call) {
        Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
        i.addCategory(Intent.CATEGORY_OPENABLE);
        i.setType(call.getString("mime", "application/octet-stream"));
        i.putExtra(Intent.EXTRA_TITLE, call.getString("name", "document"));
        startActivityForResult(call, i, "saveResult");
    }

    @ActivityCallback
    private void saveResult(PluginCall call, ActivityResult result) {
        if (call == null) return;
        if (result.getResultCode() != Activity.RESULT_OK || result.getData() == null || result.getData().getData() == null) {
            call.reject("annule");
            return;
        }
        Uri uri = result.getData().getData();
        try (OutputStream os = getContext().getContentResolver().openOutputStream(uri)) {
            os.write(Base64.decode(call.getString("data", ""), Base64.DEFAULT));
            os.flush();
            call.resolve();
        } catch (Exception e) {
            call.reject("erreur : " + e.getMessage());
        }
    }

    @PluginMethod
    public void share(PluginCall call) {
        try {
            File dir = new File(getContext().getCacheDir(), "partage");
            dir.mkdirs();
            File f = new File(dir, call.getString("name", "document"));
            try (FileOutputStream fo = new FileOutputStream(f)) {
                fo.write(Base64.decode(call.getString("data", ""), Base64.DEFAULT));
            }
            Uri uri = FileProvider.getUriForFile(getContext(), getContext().getPackageName() + ".fileprovider", f);
            Intent s = new Intent(Intent.ACTION_SEND);
            s.setType(call.getString("mime", "application/octet-stream"));
            s.putExtra(Intent.EXTRA_STREAM, uri);
            s.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            Intent ch = Intent.createChooser(s, "Partager");
            ch.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            getActivity().startActivity(ch);
            call.resolve();
        } catch (Exception e) {
            call.reject("erreur : " + e.getMessage());
        }
    }

    @PluginMethod
    public void print(PluginCall call) {
        final String title = call.getString("title", "Kalamu");
        getActivity().runOnUiThread(() -> {
            try {
                WebView wv = getBridge().getWebView();
                PrintManager pm = (PrintManager) getActivity().getSystemService(Context.PRINT_SERVICE);
                PrintDocumentAdapter ad = wv.createPrintDocumentAdapter(title);
                pm.print(title, ad, new PrintAttributes.Builder().build());
                call.resolve();
            } catch (Exception e) {
                call.reject("erreur : " + e.getMessage());
            }
        });
    }
}
</script>
<script type="text/plain" id="apk-splash">
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
